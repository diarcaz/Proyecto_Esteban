# Development only. Copy to ignored backend/.env; never commit populated secrets.
DATABASE_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Production: exact provider redis:// or rediss:// URL (includes auth/TLS as needed).
REDIS_URL=
REDIS_TLS=false
JWT_SECRET=
JWT_EXPIRATION=8h
# Required raw string >=16 trimmed characters; use a random 32-byte key in beta.
PIN_ENCRYPTION_KEY=
CORS_ORIGIN=http://localhost:3000
PORT=3001
NODE_ENV=development
# Frontend: set in frontend/.env.local or Docker build environment BEFORE build.
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
