{
  "name": "enterprise-attendance-backend",
  "version": "1.0.0",
  "description": "Enterprise Employee Attendance & Staffing Backend (NestJS, Prisma, PostgreSQL, Redis)",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "seed": "ts-node prisma/seed.ts",
    "test:security": "node -r ts-node/register -r tsconfig-paths/register src/domain/security/authorization.service.spec.ts",
    "test:phase41": "node -r ts-node/register -r tsconfig-paths/register src/domain/security/phase41-remediation.spec.ts",
    "bootstrap:admin": "node scripts/bootstrap-admin.cjs",
    "test:beta": "node --test scripts/beta-readiness.test.cjs",
    "test:phase46": "node scripts/local-test-env.cjs --test scripts/phase46-onboarding.test.cjs"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.2",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/platform-socket.io": "^12.1.2",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/websockets": "^12.1.2",
    "@prisma/client": "^5.22.0",
    "prisma": "^5.22.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "express": "^5.2.1",
    "ioredis": "^5.3.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "swagger-ui-express": "^5.0.0",
    "uuid": "^11.1.1",
    "helmet": "^7.1.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.6",
    "@nestjs/testing": "^12.1.2",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/uuid": "^9.0.7",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "tsconfig-paths": "^4.2.0"
  }
}
